# Settings
DATABASE_URL="postgres://postgres:postgres@localhost:5432/etepea?schema=public"
HOST=127.0.0.1
LOG_LEVEL=INFO
PORT=3000

FRONT_URL="http://etepea.localhost:4270"
CORS_ORIGIN="http://etepea.localhost:4270"
# Site vitrine : origine autorisée à poster une demande de démo, et adresse qui la reçoit.
SITE_URL="http://localhost:4280"
DEMO_REQUEST_TO="contact@etepea.fr"

JWT_SECRET=medisync-jwt
JWT_REFRESH_SECRET=medisync-refresh
JWT_EXPIRES_IN=60m
JWT_REFRESH_EXPIRES_IN=180d
COOKIE_SECRET=medisync-cookie

# E-mails : Mailpit en local (`docker compose --profile dev up -d` dans deploy/), UI sur
# http://localhost:8027. Sans SMTP_HOST, aucun e-mail ne part.
SMTP_HOST=localhost
SMTP_PORT=1027
SMTP_FROM="Etepea <no-reply@etepea.local>"
